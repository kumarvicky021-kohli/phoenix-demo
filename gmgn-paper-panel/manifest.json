{
  "manifest_version": 3,
  "name": "GMGN Paper Panel",
  "version": "1.1.0",
  "description": "Paper-trading panel on gmgn.ai. Demo USDT only.",
  "permissions": ["storage"],
  "host_permissions": ["https://gmgn.ai/*", "https://api.dexscreener.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Toggle GMGN Paper Panel" },
  "content_scripts": [{
    "matches": ["https://gmgn.ai/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
